transitions: {
	open: {
		time: 0.1
		offset: { 0,400 }
		opacity: 0
	}
	close: {
		time: 0.1
		offset: { 0,400 }
		opacity: 0
	}
}

autoexecs: {
	{
		action: "po32.animate"
		delay: 0
		repeat: (1/6)
	}
	{
		action: "po32.preview.changed"
		onChanged: { po32Mode }
	}
	{
		action: "po32.isRegistered.changed"
		onChanged: { isRegistered }
	}
}

@define defaultFont=ivgfont: "Inter"
@define primaryHue=0.58
@define secondaryHue=0.60
@define primaryTextColor=hsv(@primaryHue,0.16,0.87)
@define secondaryTextColor=hsv(@primaryHue,0.40,0.66)

bounds: { w-235, 90, 234, 456 }
views: {

		{
			type: "vector"
			file: "po32background"
		}
		{
			type: "dragArea"
			bounds: { 0, 0, w, h }
			hitMask: { ivgFile: "po32background" }
			bringToFront: "auto"
			hint: ""
			positionVariable: po32.windowPosition
			zOrderVariable: po32.windowZOrder
		}
		{
			type: "button"
			bounds: { 212, 65, 19, 19 }
			action: "po32.window.close"
			rounded: 100,
			standard: { fill: "#d0000000", frame: { color: "#eec4c4c4", stroke: 1.5 } }
			down: { fill: "#ff000000", frame: { color: "#eeaaaaaa", stroke: 1 } }
			vector: { code:"bounds 0,0,20,20;pen #eec4c4c4 width:2;PATH svg:[M6.5,6.5l6,6m-6,0l6,-6]" }
		}

		/*** Tabs ***/
		{
			type: "group"
			bounds: { 23, 86, 184, 24 }
			views: {
				{
					type: "button"
					bounds: { 0, 0, w/2, h }
					action: "po32.page.switch"
					params: 0
					caption: "transfer sound"
					standard: { fill: "transparent", frame:{ color:"hsv(@secondaryHue,0.22,0.68)", stroke:0.5 }, font:{ @defaultFont, size:10, color:"hsv(@secondaryHue,0.22,0.77)", gamma: 1.8 } }
					checked: { fill: "hsv(@secondaryHue,0.22,0.68)", font:{ @defaultFont, color: "black" } }
					down: { fill: "hsv(@secondaryHue,0.39,0.39)", font:{ @defaultFont, color:"hsv(@secondaryHue,0.2,0.9)" } }
					hint: "Transfer sound for selected channel"
				}
				{
					type: "button"
					bounds: { w/2, 0, w/2, h }
					action: "po32.page.switch"
					params: 1
					caption: "sounds+pattern"
					standard: { fill: "transparent", frame:{ color:"hsv(@secondaryHue,0.22,0.68)", stroke:0.5 }, font:{ @defaultFont, size:10, color:"hsv(@secondaryHue,0.22,0.77)", gamma: 1.8 } }
					checked: { fill: "hsv(@secondaryHue,0.22,0.68)", font:{ @defaultFont, color: "black" } }
					down: { fill: "hsv(@secondaryHue,0.39,0.39)", font:{ @defaultFont, color:"hsv(@secondaryHue,0.2,0.9)" } }
					hint: "Transfer selected pattern chain"
				}
			}
		}


		/*** Pages ***/
		{
			type: "paged"
			bounds: { 8, 75, 214, 374 }
			index: po32.page
			pages: {
