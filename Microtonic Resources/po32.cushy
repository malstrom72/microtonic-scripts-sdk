							}
							{
								type: "caption"
								bounds: { 69, 64, 26, 11 }
								font:{ @defaultFont, size:11, color:"@secondaryTextColor", gamma:1.8 }
								text: "acc", align:"center"
							}
							{
								type: "caption"
								bounds: { 111, 64, 44, 11 }
								font:{ @defaultFont, size:11, color:"@secondaryTextColor", gamma:1.8 }
								text: "sound", align:"center"
							}
						}
					}
							
					{   // destination button selector
						type: "group"
						bounds: { 0, 132, $, h-115 }
						views: {
							{
								type: "caption"
								bounds: { 0, 0, $, 15 }
								font:{ @defaultFont, size:11.5, color:"@primaryTextColor", gamma:1.8 }
								text: "click destination button below", align:"center"
							}

							{
								type: "caption"
								bounds: { 1, 17, $, 15 }
								font:{ @defaultFont, size:9.5, color:"@secondaryTextColor", gamma:1.8 }
								text: "([var]shortModifierKey[/var]click to reset to factory sound)", align:"center"
							}
			
							{
								type: "group"
								bounds: { 38, 42, 140, 180 }
								views: {
									@begin destButton(i, x, y)
										{
											type: "group"
											bounds: { @x, @y, 31, 41 }
											views: {
												{ type: "caption", text: "@i", bounds: { 0, 28, 32, 15 }, font:{ @defaultFont, size:12.2, color:"hsv(@primaryHue,0,0.66)", gamma:1.5 }, align: "center" }
												{ type: "button", bounds:{1,0,29,29}, rounded:100, standard: { fill:"hsv(@primaryHue,0.19,0.09)" }, down: { fill:"hsv(@primaryHue,0.52,0.46)" }, actions:{
													{ "click", "po32.transferSound.transmit", @i }
													{ "click+windows+control", "po32.transferSound.reset", @i }
													{ "click+mac+command", "po32.transferSound.reset", @i }
												} }
												{ type: "vector", guiVariables: true, variable: po32.transferSound.Instrument.@i.ivg }
											}
										}
									@end
									@destButton(1, 0, 0)
									@destButton(2, 35, 0)
									@destButton(3, 70, 0)
									@destButton(4, 105, 0)

									@destButton(5, 0, 45)
									@destButton(6, 35, 45)
									@destButton(7, 70, 45)
									@destButton(8, 105, 45)

									@destButton(9, 0, 90)
									@destButton(10, 35, 90)
									@destButton(11, 70, 90)
									@destButton(12, 105, 90)

									@destButton(13, 0, 135)
									@destButton(14, 35, 135)
									@destButton(15, 70, 135)
									@destButton(16, 105, 135)
								}
							}
						}
					}			
				}
				"1": {	/*** preset transfer ***/
					{
						type: "paged"
						bounds: { 0, 50, w, 15 }
						index: po32.preview.flash
						pages: {
							"0": {
								{
									type: "caption"
									font:{ @defaultFont, size:10, color:"hsv(0.11,1,0.88)", gamma:1.6 }
									text: "microtonic is in PO-32 preview mode", align:"center"
								}
							}
							"1": {
								{
									type: "caption"
									font:{ @defaultFont, size:10, color:"hsv(0.11,1,0.94)", gamma:2.6 }
									text: "microtonic is in PO-32 preview mode", align:"center"
								}
							}
						}
					}

					{	// optimize button
						type:"group"
						bounds:{ 45, 75, 125, 24 }
						views:{
							{
								type: "button"
								rounded: { 4, 4 }
								action: "po32.optimize",
								hint: "Shuffle channels to better fit PO-32"
								caption: "optimize for PO-32"
								standard: { fill: "hsv(@primaryHue,0.24,0.33)", frame: { color: "hsv(@primaryHue,0.24,0.44)", stroke: 1 }, font: { @defaultFont, size:11.5, color:"@primaryTextColor", gamma: 1.8 } }
								down: { fill: "hsv(@primaryHue,0.24,0.44)" }
							}
						}
					}

					{	// sound bank destination
						type: "group"
						bounds: { 0, 125, $, 40 }
						views: {
							{
								type: "caption"
								bounds: { 15, 10, 110, 15 }
								font:{ @defaultFont, size:10.4, color:"@secondaryTextColor", gamma:1.8 }
								text: "transfer sounds to"
							}

							{	/*** Source Channel Drop Down ***/
								type:"group"
								bounds:{ 113, 8, 55, 20 }
								views:{
									{
										type: "button"
										rounded: { 4, 4 }
										standard: { fill: "hsv(@primaryHue,0.24,0.33)", frame: { color: "hsv(@primaryHue,0.24,0.44)", stroke: 1 } }
										down: { fill: "hsv(@primaryHue,0.24,0.44)" }
										action: "popup", params:{
											items:{
												{ "[var]po32.transferPattern.bank.0[/var]", "po32.transferPattern.bank.set", 0 }
												{ "[var]po32.transferPattern.bank.1[/var]", "po32.transferPattern.bank.set", 1 }
											}
										}
									}
									{
										type: "caption"
										bounds:{ 4, 0, w-20, h }
										font: { @defaultFont, size:11.5, color:"@primaryTextColor", gamma: 1.8 }
										text: "[var]po32.transferPattern.bank[/var]"
										align: "center"
									}
									{	// arrow down
										type: "vector"
										bounds:{ w-12, (h/2)-2, 7, 7 }
										code: "fill @primaryTextColor; PATH svg:[M 7,0 H 0 L 3.5,5 7,0 z]"
									}
								}
							}

							{	// sound button visualization
								type: "vector"
								bounds:{ 177, 6, 24, 24 }
								guiVariables: true
								file: "po32instrument"
							}
						}
					}

					{	// pattern destination
						type: "group"
						bounds: { 0, 165, $, 40 }
						views: {
							{
								type: "caption"
								bounds: { 15, 10, 110, 15 }
								font:{ @defaultFont, size:10, color:"@secondaryTextColor", gamma:1.8 }
								text: "pattern (chain) to"
							}

							{	/*** Source Channel Drop Down ***/
								type: "group"
								bounds:{ 105, 8, 63, 20 }
								views: {
									{
										type: "group",
										varExpansion: true,
										views: {
											{
												type: "button"
												rounded: { 4, 4 }
												standard: { fill: "hsv(@primaryHue,0.24,0.33)", frame: { color: "hsv(@primaryHue,0.24,0.44)", stroke: 1 } }
												down: { fill: "hsv(@primaryHue,0.24,0.44)" }
												action: "popup", params:{ items:{ [var]po32.transferPattern.pattern.popup[/var] }	}
											}
										}
									},
									{
										type: "caption"
										bounds:{ 4, 0, w-20, h }
										font: { @defaultFont, size:11.5, color:"@primaryTextColor", gamma: 1.8 }
										text: "[var]po32.transferPattern.pattern[/var]"
										align: "center"
									}
									{	// arrow down
										type: "vector"
										bounds:{ w-12, (h/2)-2, 7, 7 }
										code: "fill @primaryTextColor; PATH svg:[M 7,0 H 0 L 3.5,5 7,0 z]"
									}
								}
							}

							{	// sound button visualization
								type: "vector"
								bounds:{ 177, 6, 24, 24 }
								guiVariables: true
								file: "po32pattern"
							}
						}
					}


					{	// instructions
						type: "group"
						bounds: { 0, 225, $, 100 }
						views: {
							{
								type: "caption"
								bounds: { 0, 0, $, 15 }
								font:{ @defaultFont, size:11.5, color:"@primaryTextColor", gamma:1.6 }
								text: "put your PO-32 in receive mode", align:"center"
							}
							{
