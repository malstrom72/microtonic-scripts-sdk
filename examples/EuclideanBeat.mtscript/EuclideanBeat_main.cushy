@include scriptSupport.makaron

@define scriptRoot=EuclideanBeat.mtscript
@define script=euclideanBeat
@define uiHue=0.6
@define backgroundColor=hsv(@uiHue,0.1,1.0)
@define frameColor=hsv(@uiHue,0.4,0.5)
@define downColor=hsv(@uiHue,1.0,0.5,0.5)
@define strokeColor=hsv(@uiHue,0.5,0.5)
@define strokeColorDisabled=hsv(@uiHue,0.3,0.8)
@define iconColor=hsv(@uiHue,0.5,0.5)
@define captionFont={ ivgfont: "sans-serif", size: 14, color: "hsv(@uiHue,0.5,0.3)" }

@begin icon_ccw_rotation(color) { ivgCode: "bounds 0,0,16,16; pen none; fill @color; path svg:[m2.34,8.86c.01.07.03.13.08.18l3.2,3.2c.2.1.4.1.5,0L9.22,8.94c.2-.2.1-.5-.2-.5H7.32,6.83C6.87,7.38,7.56,6.39,8.49,5.94,9.45,5.48,10.6,5.49,11.9,6.75L13.3,5.32C11.5,3.58,9.29,3.34,7.63,4.13,6,4.91,4.87,6.57,4.83,8.44h-.51-1.7c-.15,0-.3.23-.28.42z]" } @end
@begin icon_cw_rotation(color) { ivgCode: "bounds 0,0,16,16; pen none; fill @color; path svg:[m13.3,8.86c-.01.07-.03.13-.08.18l-3.2,3.2c-.2.1-.4.1-.5,0L6.44,8.94c-.2-.2-.1-.5.2-.5H8.34,8.83C8.79,7.38,8.1,6.39,7.17,5.94,6.21,5.48,5.04,5.49,3.73,6.75L2.34,5.32c1.79-1.73,4.03-1.97,5.69-1.18,1.63.78,2.76,2.43,2.8,4.3h.51,1.7c.15,0,.3.23.28.42z]" } @end
@begin icon_remove(color) { ivgCode: "bounds 0,0,16,16; pen @color width:2; path svg:M3,8H13" } @end
@begin icon_add(color) { ivgCode: "bounds 0,0,16,16; pen @color width:2; path svg:M3,8H13M8,3V13" } @end

transitions: {
	open: {
		time: 0.1
		scale: 90
		opacity: 0
	}
	close: {
		time: 0.1
		scale: 90
		opacity: 0
	}
}

autoexecs: {
	{
		action: "set"
		params: { @script.windowZOrder, 0 }
		onReload: false
	}
	{
		action: "@script.syncFromPreset",
		onChanged: { @script.presetIdentity, @script.selectedChannel }
	}
}

@begin rotationSwitch(parameter, inc)
	variable: "can:@script.@parameter.rotation,@inc"
	cases: {
		"false": { "nop", { enabled: false } }
		"true": { "batch", { { "@script.@parameter.rotation", "@inc" }, { "hint", { text: "rotation: [var]@script.@parameter.rotation[/var]" } } } }
	}
@end

@begin parameterViews(parameter)
	{
		{
			type: "caption"
			bounds: { 0, 0, 32, 15 }
			align: "middle right"
			font: { ivgfont: "sans-serif", size: 20, color: "hsv(@uiHue,0.5,0.3)" }
			text: "[var]@script.@parameter.onsets[/var]"
		}
		{
			type: "hover"
			bounds: { 0, 0, 32, 15 }
			cursor: "sizeNS"
		}
		{
			type: "knob"
			bounds: { 0, 0, 32, 15 }
			variable: @script.@parameter.onsets
			range: { 0, 12*16 }
			cap: {
				size: 35
				color: "transparent"
			}
			transmission: {
				vertical: 800
				horizontal: 800
			}
		}
		{
			type: "caption"
			bounds: { 37, 1, 48, 15 }
			align: "middle left"
			font: @captionFont
			text: "@parameter"
		}
		{
			type: "button"
			bounds: { 0, 20, 16, 16 }
			rounded: { 2, 2 }
			actions: {
				{ "click", "@script.@parameter.onsets", "-1" }
				{ "click+shift", "@script.@parameter.onsets", "-10" }
			}
			standard: { frame: "@strokeColor", image: @icon_remove(@iconColor) }
			disabled: { frame: "@strokeColorDisabled", image: @icon_remove(@strokeColorDisabled) }
			down: { fill: "@downColor", image: @icon_remove(@iconColor) }
		}
		{
			type: "button"
			bounds: { 18, 20, 16, 16 }
			rounded: { 2, 2 }
			actions: {
				{ "click", "@script.@parameter.onsets", "+1" }
				{ "click+shift", "@script.@parameter.onsets", "+10" }
			}
			standard: { frame: "@strokeColor", image: @icon_add(@iconColor) }
			disabled: { frame: "@strokeColorDisabled", image: @icon_add(@strokeColorDisabled) }
			down: { fill: "@downColor", image: @icon_add(@iconColor) }
		}
		{
			type: "button"
			bounds: { 52, 20, 16, 16 }
			rounded: { 2, 2 }
			actions: {	// Clumsy switch necessary because "hint" action is always enabled.
				{ "click", "switch", { @rotationSwitch(@parameter, -1) } }
				{ "click+shift", "switch", { @rotationSwitch(@parameter, -10) } }
			}
			standard: { frame: "@strokeColor", image: @icon_ccw_rotation(@iconColor) }
			disabled: { frame: "@strokeColorDisabled", image: @icon_ccw_rotation(@strokeColorDisabled) }
			down: { fill: "@downColor", image: @icon_ccw_rotation(@iconColor) }
			hint: "rotation: [var]@script.@parameter.rotation[/var]"
		}
		{
			type: "button"
			bounds: { 70, 20, 16, 16 }
			rounded: { 2, 2 }
			actions: {	// Clumsy switch necessary because "hint" action is always enabled.
				{ "click", "switch", { @rotationSwitch(@parameter, +1) } }
				{ "click+shift", "switch", { @rotationSwitch(@parameter, +10) } }
			}
			standard: { frame: "@strokeColor", image: @icon_cw_rotation(@iconColor) }
			disabled: { frame: "@strokeColorDisabled", image: @icon_cw_rotation(@strokeColorDisabled) }
			down: { fill: "@downColor", image: @icon_cw_rotation(@iconColor) }
			hint: "rotation: [var]@script.@parameter.rotation[/var]"
		}
	}
@end

@window(8, 148, 172, 210, "EuclideanBeat", @backgroundColor, @frameColor, white, @script, @<
	{
		type: "vector"
		bounds: { 4, 12, 200, 200 }
		file: "@scriptRoot/EuclideanBeat_beatCircle"
		scale: 160
		guiVariables: true
	}
	{
		type: "vector"
		bounds: { 4, 12, 200, 200 }
		file: "@scriptRoot/EuclideanBeat_playPosition"
		scale: 160
		guiVariables: true
	}
	{
		type: "group"
		bounds: { 40, 48, 88, 36 }
		views: @parameterViews(triggers)
	}
	{
		type: "group"
		bounds: { 40, 92, 88, 36 }
		views: @parameterViews(accents)
	}
	{
		type: "group"
		visibility: @script.disabled
		bounds: { 40, 48, 88, 84 }
		views: {
			{
				type: "rectangle"
				fill: "@backgroundColor"
				opacity: 90
			}
			{
				type: "caption"
				text: "click to enable"
				align: "middle center"
				font: @captionFont
			}
			{
				type: "click"
				action: "@script.enable"
			}
		}
	}
@>)
